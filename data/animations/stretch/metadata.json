{
    "id": "stretch",
    "name": "Stretch",
    "description": "Geometry move and resize transition with an elastic, rubber-band feel. The leading edge springs into the destination zone first while the rest of the window lags and stretches taut behind it, thinning slightly as it travels, then snaps to fit with a single overshoot before settling.",
    "author": "PlasmaZones",
    "version": "1.0",
    "category": "Geometry",
    "appliesTo": ["geometry"],
    "fragmentShader": "effect.frag",
    "vertexShader": "effect.vert",
    "fboExtent": "surface",
    "geometryGrid": 40,
    "parameters": [
        {
            "id": "overshoot",
            "name": "Overshoot",
            "type": "float",
            "default": 1.2,
            "min": 1.0,
            "max": 1.5
        },
        {
            "id": "spread",
            "name": "Trail Lag",
            "type": "float",
            "default": 0.45,
            "min": 0.0,
            "max": 0.8
        },
        {
            "id": "squash",
            "name": "Squash",
            "type": "float",
            "default": 0.16,
            "min": 0.0,
            "max": 0.4
        }
    ]
}
