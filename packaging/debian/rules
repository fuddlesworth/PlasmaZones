#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 fuddlesworth
# PlasmaZones Debian build rules
# SPDX-License-Identifier: GPL-3.0-or-later

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake+ninja

# PHOSPHOR_DEPS_ARCHIVES: the Luau, valijson and branding archives pinned in
# cmake/PhosphorDependencies.cmake, which CMake checks against their hashes and
# unpacks, so the build never reaches the network. packaging/deps is filled in
# both places this package is built: the OBS source package carries the
# archives there inside its orig tarball, and the release workflow's build-deb
# job fetches them there before dpkg-buildpackage (see publish-obs and
# build-deb in .github/workflows/release.yml). By hand, fill it first with
#   cmake -DPHOSPHOR_DEPS_FETCH=packaging/deps -P cmake/PhosphorDependencies.cmake
override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH) \
		-DBUILD_TESTING=OFF \
		-DPHOSPHOR_DEPS_ARCHIVES=$(CURDIR)/packaging/deps

override_dh_auto_install:
	dh_auto_install
	# Same strip as the RPM spec's %install, for the same reason: this is an
	# end-user package, not a Phosphor SDK, and there is no -devel binary by
	# design. Without it the .deb ships ~605 development files — the public
	# headers, the CMake package configs and the unversioned .so devel
	# symlinks — and lintian flags devel-file-in-non-devel-package and
	# non-dev-pkg-with-shlib-symlink. Every Phosphor/plasmazones library sets
	# SOVERSION, so the bare .so is always the devel symlink and never the
	# runtime object.
	rm -rf debian/plasmazones/usr/include/Phosphor*
	rm -rf debian/plasmazones/usr/lib/*/cmake/Phosphor*
	rm -f  debian/plasmazones/usr/lib/*/libPhosphor*.so
	rm -f  debian/plasmazones/usr/lib/*/libplasmazones*.so

override_dh_auto_test:
	# Skip tests during package build
