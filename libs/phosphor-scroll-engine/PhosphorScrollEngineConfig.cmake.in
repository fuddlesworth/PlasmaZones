@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Mirror the PUBLIC link set in CMakeLists.txt — Core plus PhosphorEngine
# (the IPlacementEngine contract the ScrollEngine implements).
find_dependency(Qt6 6.10 COMPONENTS Core)
find_dependency(PhosphorEngine)

include("${CMAKE_CURRENT_LIST_DIR}/PhosphorScrollEngineTargets.cmake")

check_required_components(PhosphorScrollEngine)
