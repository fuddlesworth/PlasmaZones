@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# EVERY Qt component the exported target names, not just the ones the library's
# own sources reach for. PhosphorAnimationTargets.cmake carries Qt6::Quick,
# Qt6::QuickPrivate and Qt6::Qml in its INTERFACE_LINK_LIBRARIES because they are
# PUBLIC here, so a Config that found only Core and Gui left a downstream
# find_package(PhosphorAnimation) failing at GENERATE time with "links to target
# Qt6::Quick but the target was not found". Pin the version to match the
# library's build minimum too; without the floor a consumer on an older Qt
# resolves cleanly and then fails with a cryptic missing symbol at link time.
find_dependency(Qt6 @PHOSPHORANIMATION_QT_MIN@ COMPONENTS Core Gui Quick Qml)
# QuickPrivate is split across distros the way GuiPrivate is: some ship a
# standalone Qt6QuickPrivateConfig.cmake, some define the target inside
# Qt6QuickConfig.cmake. Guard it the way PhosphorRenderingConfig guards
# GuiPrivate so this is portable across both.
if(NOT TARGET Qt6::QuickPrivate)
    find_dependency(Qt6QuickPrivate @PHOSPHORANIMATION_QT_MIN@)
endif()

# PhosphorRegistry is a PUBLIC link dependency — AnimationShaderRegistry's public
# header exposes Registry<AnimationPack> + MetadataPackLoader<AnimationPack>, and
# CurveRegistry composes Registry<CurveFactoryEntry> — so the exported target
# references PhosphorRegistry::PhosphorRegistry and a standalone find_package
# consumer must resolve it. (find_dependency(PhosphorRegistry) transitively pulls
# PhosphorFsLoader via PhosphorRegistry's own Config.)
find_dependency(PhosphorRegistry 0.1.0)

# The rest of the PUBLIC link set. Each is referenced by the exported targets
# file, so a consumer that cannot resolve it gets a hard find_package failure
# rather than a late link error.
find_dependency(PhosphorShaders)
find_dependency(PhosphorLayer)
find_dependency(PhosphorRendering)

include("${CMAKE_CURRENT_LIST_DIR}/PhosphorAnimationTargets.cmake")

# QML types were consolidated into this library in the Phase 5 merge.
# Consumers that previously called find_package(PhosphorAnimationQml)
# should now link against PhosphorAnimation::PhosphorAnimationQml instead.

check_required_components(PhosphorAnimation)
