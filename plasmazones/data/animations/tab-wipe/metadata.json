{
    "id": "tab-wipe",
    "name": "Tab Wipe",
    "description": "Sweeps the tab you picked across the column over the one you left, with a soft edge you can widen into a gradient or tighten to a hard line. Neither tab moves, so the column stays put while its contents change.",
    "author": "PlasmaZones",
    "version": "1.0",
    "category": "Reveal",
    "appliesTo": ["tab"],
    "fragmentShader": "effect.frag",
    "parameters": [
        {
            "id": "dirX",
            "name": "Direction X",
            "type": "float",
            "default": 1.0,
            "min": -1.0,
            "max": 1.0
        },
        {
            "id": "dirY",
            "name": "Direction Y",
            "type": "float",
            "default": 0.0,
            "min": -1.0,
            "max": 1.0
        },
        {
            "id": "softness",
            "name": "Edge Softness",
            "type": "float",
            "default": 0.15,
            "min": 0.0,
            "max": 0.5
        }
    ]
}
