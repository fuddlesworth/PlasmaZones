{
    "id": "ripple-snap",
    "name": "Ripple Snap",
    "description": "Geometry move and resize transition where the window flies into its destination zone and a wave ripples across it from the edge that lands first, like a sheet snapping taut. The ripple fades out as the window settles flat into the slot.",
    "author": "PlasmaZones",
    "version": "1.0",
    "category": "Geometry",
    "appliesTo": ["geometry"],
    "fragmentShader": "effect.frag",
    "vertexShader": "effect.vert",
    "fboExtent": "surface",
    "geometryGrid": 48,
    "parameters": [
        {
            "id": "impact",
            "name": "Impact Point",
            "type": "float",
            "default": 0.4,
            "min": 0.1,
            "max": 0.7
        },
        {
            "id": "speed",
            "name": "Wave Speed",
            "type": "float",
            "default": 1.6,
            "min": 0.5,
            "max": 3.0
        },
        {
            "id": "waves",
            "name": "Wave Count",
            "type": "float",
            "default": 3.0,
            "min": 1.0,
            "max": 6.0
        },
        {
            "id": "decay",
            "name": "Wave Falloff",
            "type": "float",
            "default": 3.5,
            "min": 1.0,
            "max": 8.0
        },
        {
            "id": "amplitude",
            "name": "Amplitude",
            "type": "float",
            "default": 0.06,
            "min": 0.0,
            "max": 0.15
        },
        {
            "id": "shade",
            "name": "Shading",
            "type": "float",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0
        }
    ]
}
